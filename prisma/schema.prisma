generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  staff
}

enum AppDepartment {
  aircraft_management
  charter
  data_warehouse
}

enum ProspectType {
  individual_owner
  company_owner
  family_office
  broker_referral
  aircraft_buyer
  existing_client
  other
}

enum OpportunityType {
  aircraft_management
  management_with_charter
  part91_only
  acquisition_support
  transition
  charter_optimization
  shared_ownership
  other
}

enum DataConfidence {
  low
  medium
  high
}

enum AircraftCategory {
  light_jet
  midsize_jet
  super_midsize_jet
  large_cabin_jet
  ultra_long_range_jet
  turboprop
  piston
  helicopter
  other
}

enum ValueSource {
  owner_provided
  broker_estimate
  vref
  aircraft_bluebook
  jetnet
  amstat
  internal_estimate
  appraisal
  other
}

enum InteriorCondition {
  excellent
  good
  fair
  needs_refurb
}

enum PaintCondition {
  excellent
  good
  fair
  needs_repaint
}

enum CrewRole {
  pic
  sic
  cabin_attendant
}

enum TrainingType {
  initial
  recurrent
}

enum ProgramType {
  engine
  apu
  parts
  airframe
  avionics
  other
}

enum FeatureCostType {
  one_time
  monthly
  annual
}

enum HangarPricingMethod {
  quoted
  sqft_rate
  category_estimate
}

enum ProposalStatus {
  draft
  internal_review
  approved
  published
  viewed
  revised
  won
  lost
}

enum PipelineStage {
  lead_research
  building
  internal_review
  client_review
  closed
}

enum AssumptionSourceType {
  manual
  reference_table
  calculated
  default
}

enum SectionType {
  cover
  executive_summary
  aircraft_overview
  management_approach
  operating_assumptions
  charter_strategy
  pro_forma
  cost_breakdown
  transition_plan
  team
  next_steps
  disclaimer
  welcome
  about_us
  aircraft_management
  aircraft_charter
  maintenance
  sales_acquisitions
  conformity_process
  custom_page
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  email        String          @unique
  passwordHash String?         @map("password_hash")
  supabaseId   String?         @unique @map("supabase_id")
  role         UserRole        @default(staff)
  departments  AppDepartment[] @default([])
  active       Boolean         @default(true)
  permissions  Json?           @db.JsonB
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  prospectsCreated                Prospect[]                @relation("ProspectCreatedBy")
  prospectsAssigned               Prospect[]                @relation("ProspectAssignedTo")
  invitesSent                     UserInvite[]              @relation("UserInviteSentBy")
  proposalsPrepared               Proposal[]                @relation("ProposalPreparedBy")
  proposalsReviewed               Proposal[]                @relation("ProposalReviewedBy")
  proposalsApproved               Proposal[]                @relation("ProposalApprovedBy")
  snapshotsPublished              ProposalSnapshot[]        @relation("SnapshotPublishedBy")
  proposalComments                ProposalComment[]
  charterRequestsCreated          CharterRequest[]          @relation("CharterRequestCreatedBy")
  emptyLegsForceApplied           EmptyLeg[]                @relation("EmptyLegForceAppliedBy")
  charterLeadsAssigned            CharterLead[]             @relation("CharterLeadAssignedTo")
  airportTimezoneOverridesUpdated AirportTimezoneOverride[] @relation("AirportTimezoneOverrideUpdatedBy")

  @@map("users")
}

model Prospect {
  id              String          @id @default(uuid()) @db.Uuid
  prospectName    String          @map("prospect_name")
  companyName     String?         @map("company_name")
  contactName     String          @map("contact_name")
  contactEmail    String          @map("contact_email")
  contactPhone    String?         @map("contact_phone")
  prospectType    ProspectType    @map("prospect_type")
  currentManager  String?         @map("current_manager")
  opportunityType OpportunityType @map("opportunity_type")
  internalNotes   String?         @map("internal_notes") @db.Text
  clientSummary   String?         @map("client_summary") @db.Text
  createdById     String          @map("created_by") @db.Uuid
  pipelineStatus  String?         @map("pipeline_status")
  followUpDate    DateTime?       @map("follow_up_date") @db.Date
  assignedToId    String?         @map("assigned_to") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  createdBy  User               @relation("ProspectCreatedBy", fields: [createdById], references: [id])
  assignedTo User?              @relation("ProspectAssignedTo", fields: [assignedToId], references: [id])
  aircraft   AircraftInstance[]
  proposals  Proposal[]

  @@map("prospects")
}

enum PaybackBasis {
  block_time
  flight_time
}

enum AircraftTypeStatus {
  draft
  published
}

enum AircraftTailStatus {
  active
  retired
}

enum AircraftPerformanceMetric {
  takeoffFieldLength
  landingDistance
}

/**
 * Unified aircraft type (warehouse master).
 * Owns identity, base performance (fuel burn), Crew grids, AM economics,
 * and empty-leg default pricing. Actual airframe weights live on AircraftTail.
 */
model AircraftType {
  id                         String             @id @default(uuid()) @db.Uuid
  status                     AircraftTypeStatus @default(draft) @map("status")
  /**
   * Crew / ops type code (e.g. B300). Unique when set.
   */
  code                       String?            @unique
  /**
   * AM display name (unique).
   */
  displayName                String             @unique @map("display_name")
  /**
   * Per optional-field Show/Hide for pro forma (xlsx rule A2).
   */
  proformaFieldVisibility    Json?              @map("proforma_field_visibility")
  manufacturer               String?
  model                      String?
  modelCode                  String?            @map("model_code")
  aircraftCategory           AircraftCategory?  @map("aircraft_category")
  passengerCapacity          Int?               @map("passenger_capacity")
  maxPassengers              Int?               @map("max_passengers")
  emptyRange                 Int?               @map("empty_range")
  rangeAtMaxPassengers       Int?               @map("range_at_max_passengers")
  crewCount                  Int?               @map("crew_count")
  squareFootage              Int?               @map("square_footage")
  averageCruiseSpeed         Int?               @map("average_cruise_speed")
  wifi                       Boolean?
  homeFuelPct                Int?               @map("home_fuel_pct")
  /// Base performance — type-level fuel burn (gph).
  fuelGallonsPerHour         Int?               @map("fuel_gallons_per_hour")
  partsProgram               Int?               @map("parts_program")
  engineProgram              Int?               @map("engine_program")
  apuProgram                 Int?               @map("apu_program")
  inspectionReserve          Int?               @map("inspection_reserve")
  tripExpenseHourly          Int?               @map("trip_expense_hourly")
  defaultMinimumCrew         Int?               @map("default_minimum_crew")
  leadPilotSalary            Int?               @map("lead_pilot_salary")
  leadPilotTrainingCost      Int?               @map("lead_pilot_training_cost")
  picSalary                  Int?               @map("pic_salary")
  sicSalary                  Int?               @map("sic_salary")
  cabinAttendantSalary       Int?               @map("cabin_attendant_salary")
  picTrainingCost            Int?               @map("pic_training_cost")
  sicTrainingCost            Int?               @map("sic_training_cost")
  maxUsage1Pilot             Int?               @map("max_usage_1_pilot")
  maxUsage2Pilots            Int?               @map("max_usage_2_pilots")
  maxUsage3Pilots            Int?               @map("max_usage_3_pilots")
  maxUsage4Pilots            Int?               @map("max_usage_4_pilots")
  maxUsage5Pilots            Int?               @map("max_usage_5_pilots")
  maxUsage6Pilots            Int?               @map("max_usage_6_pilots")
  averageCost                Int?               @map("average_cost")
  charterHourlyRate          Int?               @map("charter_hourly_rate")
  charterPaybackBasis        PaybackBasis?      @map("charter_payback_basis")
  fuelSurchargePaybackBasis  PaybackBasis?      @map("fuel_surcharge_payback_basis")
  fuelSurcharge              Int?               @map("fuel_surcharge")
  pilotCharterIncentive      Int?               @map("pilot_charter_incentive")
  airframeProgram            Int?               @map("airframe_program")
  maintenanceReserve         Int?               @map("maintenance_reserve")
  defaultCabinAttendantCount Int?               @map("default_cabin_attendant_count")
  wifiAnnual                 Int?               @map("wifi_annual")
  subscriptionsAnnual        Int?               @map("subscriptions_annual")
  cleaningAnnual             Int?               @map("cleaning_annual")
  suppliesAnnual             Int?               @map("supplies_annual")
  airportFeesAnnual          Int?               @map("airport_fees_annual")
  /// Optional Crew PerformanceModel (slope/wind/climb refs).
  performanceModel           Json?              @map("performance_model") @db.JsonB
  /// Ops notes for AFM completeness (also derived notes may ship on /sync).
  afmNotes                   String?            @map("afm_notes") @db.Text
  /// Active AFM/POH PDF (human source of truth; grids remain separate JSON).
  afmPdfUrl                  String?            @map("afm_pdf_url")
  afmPdfFileName             String?            @map("afm_pdf_file_name")
  afmPdfCategory             String?            @default("afm_poh") @map("afm_pdf_category")
  afmPdfRevision             String?            @map("afm_pdf_revision")
  afmPdfEffectiveDate        DateTime?          @map("afm_pdf_effective_date") @db.Date
  afmPdfUploadedAt           DateTime?          @map("afm_pdf_uploaded_at")
  /// Empty-leg calculated pricing defaults (type-level).
  emptyLegHourlyRate         Decimal?           @map("empty_leg_hourly_rate") @db.Decimal(12, 2)
  emptyLegMinimumHours       Decimal?           @map("empty_leg_minimum_hours") @db.Decimal(6, 2)
  emptyLegOffRoutingHours    Decimal?           @map("empty_leg_off_routing_hours") @db.Decimal(6, 2)
  /// Future JetNet / Conklin / etc.
  externalSource             String?            @default("atlas") @map("external_source")
  externalId                 String?            @map("external_id")
  externalSyncedAt           DateTime?          @map("external_synced_at")
  legacyWarehouseAircraftId  String?            @unique @map("legacy_warehouse_aircraft_id") @db.Uuid
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")

  tails           AircraftTail[]
  performance     AircraftPerformanceGrid[]
  instances       AircraftInstance[]
  hangarOverrides FboHangarOverride[]

  @@map("aircraft_types")
}

/**
 * Unified fleet tail (one physical airplane).
 * Owns ops identity, actual weights, empty-leg marketing, and pricing overrides.
 */
model AircraftTail {
  id                         String             @id @default(uuid()) @db.Uuid
  tailNumber                 String             @unique @map("tail_number")
  aircraftTypeId             String             @map("aircraft_type_id") @db.Uuid
  status                     AircraftTailStatus @default(active)
  homeBase                   String?            @map("home_base")
  serialNumber               String?            @map("serial_number")
  /// Remaining Crew operating factors (GOM, burn rate, etc.). Key weights also promoted below.
  operating                  Json               @default("{}") @db.JsonB
  basicEmptyWeightLb         Int?               @map("basic_empty_weight_lb")
  mtowLb                     Int?               @map("mtow_lb")
  mzfwLb                     Int?               @map("mzfw_lb")
  maxBagWeightLb             Int?               @map("max_bag_weight_lb")
  publicDisplayType          String?            @map("public_display_type")
  seatCount                  Int?               @map("seat_count")
  luggageNote                String?            @map("luggage_note")
  wifi                       Boolean            @default(false)
  amenitiesJson              Json               @default("[]") @map("amenities_json") @db.JsonB
  description                String?            @db.Text
  primaryPhotoUrl            String?            @map("primary_photo_url")
  photoUrlsJson              Json               @default("[]") @map("photo_urls_json") @db.JsonB
  isPublicActive             Boolean            @default(true) @map("is_public_active")
  emptyLegHourlyRateOverride Decimal?           @map("empty_leg_hourly_rate_override") @db.Decimal(12, 2)
  externalSource             String?            @default("atlas") @map("external_source")
  externalId                 String?            @map("external_id")
  externalSyncedAt           DateTime?          @map("external_synced_at")
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")

  aircraftType          AircraftType          @relation(fields: [aircraftTypeId], references: [id], onDelete: Restrict)
  scheduleEvents        ScheduleEvent[]
  charterRequestMatches CharterRequestMatch[]
  emptyLegs             EmptyLeg[]
  instances             AircraftInstance[]

  @@index([aircraftTypeId])
  @@map("aircraft_tails")
}

model AircraftPerformanceGrid {
  id                 String                    @id @default(uuid()) @db.Uuid
  aircraftTypeId     String                    @map("aircraft_type_id") @db.Uuid
  metric             AircraftPerformanceMetric
  unit               String                    @default("ft")
  pressureAltitudeFt Int[]                     @map("pressure_altitude_ft")
  weightLb           Int[]                     @map("weight_lb")
  oatC               Int[]                     @map("oat_c")
  values             Json                      @db.JsonB
  /// Provenance e.g. "King Air 350 B300 POH Section 5…" or "calibrated stand-in".
  source             String?                   @db.Text
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  aircraftType AircraftType @relation(fields: [aircraftTypeId], references: [id], onDelete: Cascade)

  @@unique([aircraftTypeId, metric])
  @@map("aircraft_performance_grids")
}

/**
 * Org Crew PolicyStore thresholds (singleton id = default).
 */
model CrewOrgPolicy {
  id         String   @id @default("default")
  thresholds Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("crew_org_policy")
}

// One row per FBO (Atlas Database.xlsx "FBOs" tab).
model Fbo {
  id                String   @id @default(uuid()) @db.Uuid
  fboName           String   @map("fbo_name")
  airportIcao       String   @map("airport_icao")
  baseFuelRate      Decimal  @map("base_fuel_rate") @db.Decimal(10, 4)
  hangarCostPerSqft Decimal? @map("hangar_cost_per_sqft") @db.Decimal(10, 4)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  hangarOverrides FboHangarOverride[]

  @@unique([fboName, airportIcao])
  @@index([airportIcao])
  @@map("fbos")
}

/**
 * Also drives the per-aircraft regulatory usage type (formerly the hardcoded
 * USAGE_TYPE_OPTIONS in lib/aircraft-workspace.ts) — charterEnabled gates
 * charter-related pro forma fields and warehouse defaults.
 */
model UsageType {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)
  charterEnabled Boolean  @default(false) @map("charter_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([name])
  @@map("usage_types")
}

// Per-aircraft hangar annual override for a given FBO ("Specific Hangar Rate").
model FboHangarOverride {
  id             String   @id @default(uuid()) @db.Uuid
  fboId          String   @map("fbo_id") @db.Uuid
  aircraftTypeId String   @map("aircraft_type_id") @db.Uuid
  annualRate     Int      @map("annual_rate")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  fbo          Fbo          @relation(fields: [fboId], references: [id], onDelete: Cascade)
  aircraftType AircraftType @relation(fields: [aircraftTypeId], references: [id], onDelete: Cascade)

  @@unique([fboId, aircraftTypeId])
  @@map("fbo_hangar_overrides")
}

// Single-row global defaults (Atlas Database.xlsx "General and Company" tab).
model CompanySettings {
  id                             String   @id @default("default")
  usAverageFuelCost              Decimal  @default(5.5) @map("us_average_fuel_cost") @db.Decimal(10, 4)
  annualManagementFee            Int      @default(120000) @map("annual_management_fee")
  annualMaintenanceManagementFee Int      @default(60000) @map("annual_maintenance_management_fee")
  charterPaybackPercent          Decimal  @default(82.5) @map("charter_payback_percent") @db.Decimal(6, 3)
  crewBenefitsPercent            Decimal  @default(0.16) @map("crew_benefits_percent") @db.Decimal(6, 4)
  fuelTaxRefund                  Decimal  @default(0.175) @map("fuel_tax_refund") @db.Decimal(10, 4)
  charterBlockToFlightRatio      Decimal  @default(1.13) @map("charter_block_to_flight_ratio") @db.Decimal(6, 4)
  defaultInsuranceMode           String?  @map("default_insurance_mode")
  defaultInsuranceAnnual         Int?     @map("default_insurance_annual")
  defaultInsurancePremiumPercent Decimal? @map("default_insurance_premium_percent") @db.Decimal(6, 3)
  defaultRegistrationTaxRate     Decimal? @map("default_registration_tax_rate") @db.Decimal(6, 4)
  defaultDownPaymentPercent      Decimal? @map("default_down_payment_percent") @db.Decimal(6, 3)
  defaultInterestRate            Decimal? @map("default_interest_rate") @db.Decimal(6, 4)
  defaultTermMonths              Int?     @map("default_term_months")
  defaultBalloonPayment          Int?     @map("default_balloon_payment")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model AircraftInstance {
  id                          String             @id @default(uuid()) @db.Uuid
  aircraftTypeId              String?            @map("aircraft_type_id") @db.Uuid
  aircraftTailId              String?            @map("aircraft_tail_id") @db.Uuid
  /**
   * @deprecated Use aircraftTypeId. Kept for migration compatibility.
   */
  warehouseAircraftId         String?            @map("warehouse_aircraft_id") @db.Uuid
  prospectId                  String             @map("prospect_id") @db.Uuid
  proposalId                  String?            @map("proposal_id") @db.Uuid
  tailNumber                  String?            @map("tail_number")
  serialNumber                String?            @map("serial_number")
  year                        Int?
  /// @deprecated Use proposal assumption `aircraft_value` instead. Backfill via scripts/migrate-legacy-assumptions.ts --backfill-estimated-value
  estimatedValue              Decimal?           @map("estimated_value") @db.Decimal(14, 2)
  valueSource                 ValueSource?       @map("value_source")
  currentManager              String?            @map("current_manager")
  currentOperator             String?            @map("current_operator")
  currentHomeBaseIcao         String?            @map("current_home_base_icao")
  proposedHomeBaseIcao        String?            @map("proposed_home_base_icao")
  engineModel                 String?            @map("engine_model")
  apuModel                    String?            @map("apu_model")
  wifiSystem                  String?            @map("wifi_system")
  maintenanceTrackingProvider String?            @map("maintenance_tracking_provider")
  programStatus               String?            @map("program_status")
  interiorCondition           InteriorCondition? @map("interior_condition")
  paintCondition              PaintCondition?    @map("paint_condition")
  knownInspections            String?            @map("known_inspections") @db.Text
  deferredMaintenance         String?            @map("deferred_maintenance") @db.Text
  internalNotes               String?            @map("internal_notes") @db.Text
  clientSummary               String?            @map("client_summary") @db.Text
  portalImageUrl              String?            @map("portal_image_url")
  portalVideoUrl              String?            @map("portal_video_url")
  portalSpecHighlights        Json?              @map("portal_spec_highlights") @db.JsonB
  includedOnProposal          Boolean            @default(true) @map("included_on_proposal")
  fboName                     String?            @map("fbo_name")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")

  aircraftType AircraftType?      @relation(fields: [aircraftTypeId], references: [id])
  aircraftTail AircraftTail?      @relation(fields: [aircraftTailId], references: [id])
  prospect     Prospect           @relation(fields: [prospectId], references: [id])
  proposal     Proposal?          @relation("ProposalAircraft", fields: [proposalId], references: [id], onDelete: Cascade)
  proposals    Proposal[]         @relation("ProposalPrimaryAircraft")
  scenarios    ProposalScenario[]

  @@map("aircraft_instances")
}

// Global reference data from OurAirports open data (https://ourairports.com/data/)
model CountryReference {
  id            Int      @id @map("ourairports_id")
  code          String   @unique
  name          String
  continent     String?
  wikipediaLink String?  @map("wikipedia_link")
  keywords      String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("country_reference")
}

model RegionReference {
  id            Int      @id @map("ourairports_id")
  code          String   @unique
  localCode     String?  @map("local_code")
  name          String
  continent     String?
  isoCountry    String   @map("iso_country")
  wikipediaLink String?  @map("wikipedia_link")
  keywords      String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isoCountry])
  @@map("region_reference")
}

model AirportReference {
  id               String   @id @default(uuid()) @db.Uuid
  ourairportsId    Int      @unique @map("ourairports_id")
  ident            String   @unique
  icao             String?  @unique
  iata             String?
  airportType      String   @map("airport_type")
  name             String
  latitudeDeg      Decimal? @map("latitude_deg") @db.Decimal(10, 7)
  longitudeDeg     Decimal? @map("longitude_deg") @db.Decimal(10, 7)
  elevationFt      Int?     @map("elevation_ft")
  continent        String?
  isoCountry       String   @map("iso_country")
  isoRegion        String?  @map("iso_region")
  municipality     String?
  scheduledService Boolean  @default(false) @map("scheduled_service")
  gpsCode          String?  @map("gps_code")
  localCode        String?  @map("local_code")
  homeLink         String?  @map("home_link")
  wikipediaLink    String?  @map("wikipedia_link")
  keywords         String?  @db.Text
  longestRunwayFt  Int?     @map("longest_runway_ft")
  sourceVersion    String?  @map("source_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  runways     AirportRunwayReference[]
  frequencies AirportFrequencyReference[]

  @@index([iata])
  @@index([isoCountry])
  @@index([municipality])
  @@index([name])
  @@map("airport_reference")
}

model AirportRunwayReference {
  id                      String   @id @default(uuid()) @db.Uuid
  ourairportsId           Int      @unique @map("ourairports_id")
  airportId               String   @map("airport_id") @db.Uuid
  airportIdent            String   @map("airport_ident")
  lengthFt                Int?     @map("length_ft")
  widthFt                 Int?     @map("width_ft")
  surface                 String?
  lighted                 Boolean  @default(false)
  closed                  Boolean  @default(false)
  leIdent                 String?  @map("le_ident")
  leLatitudeDeg           Decimal? @map("le_latitude_deg") @db.Decimal(10, 7)
  leLongitudeDeg          Decimal? @map("le_longitude_deg") @db.Decimal(10, 7)
  leElevationFt           Int?     @map("le_elevation_ft")
  leHeadingDegT           Int?     @map("le_heading_deg_t")
  leDisplacedThresholdFt  Int?     @map("le_displaced_threshold_ft")
  heIdent                 String?  @map("he_ident")
  heLatitudeDeg           Decimal? @map("he_latitude_deg") @db.Decimal(10, 7)
  heLongitudeDeg          Decimal? @map("he_longitude_deg") @db.Decimal(10, 7)
  heElevationFt           Int?     @map("he_elevation_ft")
  heHeadingDegT           Int?     @map("he_heading_deg_t")
  heDisplacedThresholdFt  Int?     @map("he_displaced_threshold_ft")
  gradientPctVerified     Float?   @map("gradient_pct_verified")
  gradientHighEndVerified String?  @map("gradient_high_end_verified")
  gradientPctEstimated    Float?   @map("gradient_pct_estimated")

  airport AirportReference @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@index([airportId])
  @@index([airportIdent])
  @@map("airport_runway_reference")
}

model AirportFrequencyReference {
  id            String   @id @default(uuid()) @db.Uuid
  ourairportsId Int      @unique @map("ourairports_id")
  airportId     String   @map("airport_id") @db.Uuid
  airportIdent  String   @map("airport_ident")
  type          String
  description   String?
