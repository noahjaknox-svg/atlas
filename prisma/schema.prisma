generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  sales
  reviewer
  charter
}

enum ProspectType {
  individual_owner
  company_owner
  family_office
  broker_referral
  aircraft_buyer
  existing_client
  other
}

enum OpportunityType {
  aircraft_management
  management_with_charter
  part91_only
  acquisition_support
  transition
  charter_optimization
  shared_ownership
  other
}

enum DataConfidence {
  low
  medium
  high
}

enum AircraftCategory {
  light_jet
  midsize_jet
  super_midsize_jet
  large_cabin_jet
  ultra_long_range_jet
  turboprop
  piston
  helicopter
  other
}

enum ValueSource {
  owner_provided
  broker_estimate
  vref
  aircraft_bluebook
  jetnet
  amstat
  internal_estimate
  appraisal
  other
}

enum InteriorCondition {
  excellent
  good
  fair
  needs_refurb
}

enum PaintCondition {
  excellent
  good
  fair
  needs_repaint
}

enum CrewRole {
  pic
  sic
  cabin_attendant
}

enum TrainingType {
  initial
  recurrent
}

enum ProgramType {
  engine
  apu
  parts
  airframe
  avionics
  other
}

enum FeatureCostType {
  one_time
  monthly
  annual
}

enum HangarPricingMethod {
  quoted
  sqft_rate
  category_estimate
}

enum ProposalStatus {
  draft
  internal_review
  approved
  published
  viewed
  revised
  won
  lost
}

enum PipelineStage {
  lead_research
  building
  internal_review
  client_review
  closed
}

enum AssumptionSourceType {
  manual
  reference_table
  calculated
  default
}

enum SectionType {
  cover
  executive_summary
  aircraft_overview
  management_approach
  operating_assumptions
  charter_strategy
  pro_forma
  cost_breakdown
  transition_plan
  team
  next_steps
  disclaimer
  welcome
  about_us
  aircraft_management
  aircraft_charter
  maintenance
  sales_acquisitions
  conformity_process
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String?  @map("password_hash")
  supabaseId   String?  @unique @map("supabase_id")
  role         UserRole @default(sales)
  active       Boolean  @default(true)
  permissions  Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  prospectsCreated       Prospect[]         @relation("ProspectCreatedBy")
  prospectsAssigned      Prospect[]         @relation("ProspectAssignedTo")
  invitesSent            UserInvite[]       @relation("UserInviteSentBy")
  proposalsPrepared      Proposal[]         @relation("ProposalPreparedBy")
  proposalsReviewed      Proposal[]         @relation("ProposalReviewedBy")
  proposalsApproved      Proposal[]         @relation("ProposalApprovedBy")
  snapshotsPublished     ProposalSnapshot[] @relation("SnapshotPublishedBy")
  proposalComments       ProposalComment[]
  charterRequestsCreated CharterRequest[]   @relation("CharterRequestCreatedBy")

  @@map("users")
}

model Prospect {
  id              String          @id @default(uuid()) @db.Uuid
  prospectName    String          @map("prospect_name")
  companyName     String?         @map("company_name")
  contactName     String          @map("contact_name")
  contactEmail    String          @map("contact_email")
  contactPhone    String?         @map("contact_phone")
  prospectType    ProspectType    @map("prospect_type")
  currentManager  String?         @map("current_manager")
  opportunityType OpportunityType @map("opportunity_type")
  internalNotes   String?         @map("internal_notes") @db.Text
  clientSummary   String?         @map("client_summary") @db.Text
  createdById     String          @map("created_by") @db.Uuid
  pipelineStatus  String?         @map("pipeline_status")
  followUpDate    DateTime?       @map("follow_up_date") @db.Date
  assignedToId    String?         @map("assigned_to") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  createdBy  User               @relation("ProspectCreatedBy", fields: [createdById], references: [id])
  assignedTo User?              @relation("ProspectAssignedTo", fields: [assignedToId], references: [id])
  aircraft   AircraftInstance[]
  proposals  Proposal[]

  @@map("prospects")
}

enum PaybackBasis {
  block_time
  flight_time
}

enum WarehouseAircraftStatus {
  draft
  published
}

// Consolidated warehouse aircraft record (one per aircraft, copyable, unique display name).
// Matches the "Aircraft" tab in Atlas Database.xlsx.
model WarehouseAircraft {
  id                        String                    @id @default(uuid()) @db.Uuid
  status                    WarehouseAircraftStatus   @default(draft) @map("status")
  /** Per optional-field Show/Hide for pro forma (xlsx rule A2). Keys = field names, true = show. */
  proformaFieldVisibility     Json?                     @map("proforma_field_visibility")
  // General
  displayName               String                    @unique @map("display_name")
  manufacturer              String?
  model                     String?
  modelCode                 String?                   @map("model_code")
  aircraftCategory          AircraftCategory?         @map("aircraft_category")
  passengerCapacity         Int?                      @map("passenger_capacity")
  emptyRange                Int?                      @map("empty_range")
  rangeAtMaxPassengers      Int?                      @map("range_at_max_passengers")
  crewCount                 Int?                      @map("crew_count")
  squareFootage             Int?                      @map("square_footage")
  averageCruiseSpeed        Int?                      @map("average_cruise_speed")
  wifi                      Boolean?
  /** Percent of fuel purchased at home base (0–100). */
  homeFuelPct               Int?                      @map("home_fuel_pct")
  // Hourly Rates
  fuelGallonsPerHour        Int?                      @map("fuel_gallons_per_hour")
  partsProgram              Int?                      @map("parts_program")
  engineProgram             Int?                      @map("engine_program")
  apuProgram                Int?                      @map("apu_program")
  inspectionReserve         Int?                      @map("inspection_reserve")
  tripExpenseHourly         Int?                      @map("trip_expense_hourly")
  // Crew
  leadPilotCount            Int?                      @map("lead_pilot_count")
  picCount                  Int?                      @map("pic_count")
  sicCount                  Int?                      @map("sic_count")
  cabinAttendantCount       Int?                      @map("cabin_attendant_count")
  leadPilotSalary           Int?                      @map("lead_pilot_salary")
  picSalary                 Int?                      @map("pic_salary")
  sicSalary                 Int?                      @map("sic_salary")
  cabinAttendantSalary      Int?                      @map("cabin_attendant_salary")
  picTrainingCost           Int?                      @map("pic_training_cost")
  sicTrainingCost           Int?                      @map("sic_training_cost")
  // Utilization (max annual hours by pilot count)
  maxUsage1Pilot            Int?                      @map("max_usage_1_pilot")
  maxUsage2Pilots           Int?                      @map("max_usage_2_pilots")
  maxUsage3Pilots           Int?                      @map("max_usage_3_pilots")
  maxUsage4Pilots           Int?                      @map("max_usage_4_pilots")
  maxUsage5Pilots           Int?                      @map("max_usage_5_pilots")
  maxUsage6Pilots           Int?                      @map("max_usage_6_pilots")
  // Finances
  averageCost               Int?                      @map("average_cost")
  charterHourlyRate         Int?                      @map("charter_hourly_rate")
  charterPaybackBasis       PaybackBasis?             @map("charter_payback_basis")
  fuelSurchargePaybackBasis PaybackBasis?             @map("fuel_surcharge_payback_basis")
  fuelSurcharge             Int?                      @map("fuel_surcharge")
  pilotCharterIncentive     Int?                      @map("pilot_charter_incentive")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")

  instances       AircraftInstance[]
  hangarOverrides FboHangarOverride[]

  @@map("warehouse_aircraft")
}

// One row per FBO (Atlas Database.xlsx "FBOs" tab).
model Fbo {
  id                String   @id @default(uuid()) @db.Uuid
  fboName           String   @map("fbo_name")
  airportIcao       String   @map("airport_icao")
  baseFuelRate      Decimal  @map("base_fuel_rate") @db.Decimal(10, 4)
  hangarCostPerSqft Decimal? @map("hangar_cost_per_sqft") @db.Decimal(10, 4)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  hangarOverrides FboHangarOverride[]

  @@unique([fboName, airportIcao])
  @@index([airportIcao])
  @@map("fbos")
}

// Per-aircraft hangar annual override for a given FBO ("Specific Hangar Rate").
model FboHangarOverride {
  id                  String   @id @default(uuid()) @db.Uuid
  fboId               String   @map("fbo_id") @db.Uuid
  warehouseAircraftId String   @map("warehouse_aircraft_id") @db.Uuid
  annualRate          Int      @map("annual_rate")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  fbo               Fbo               @relation(fields: [fboId], references: [id], onDelete: Cascade)
  warehouseAircraft WarehouseAircraft @relation(fields: [warehouseAircraftId], references: [id], onDelete: Cascade)

  @@unique([fboId, warehouseAircraftId])
  @@map("fbo_hangar_overrides")
}

// Single-row global defaults (Atlas Database.xlsx "General and Company" tab).
model CompanySettings {
  id                             String   @id @default("default")
  usAverageFuelCost              Decimal  @default(5.5) @map("us_average_fuel_cost") @db.Decimal(10, 4)
  annualManagementFee            Int      @default(120000) @map("annual_management_fee")
  annualMaintenanceManagementFee Int      @default(60000) @map("annual_maintenance_management_fee")
  charterPaybackPercent          Decimal  @default(82.5) @map("charter_payback_percent") @db.Decimal(6, 3)
  crewBenefitsPercent            Decimal  @default(0.16) @map("crew_benefits_percent") @db.Decimal(6, 4)
  fuelTaxRefund                  Decimal  @default(0.175) @map("fuel_tax_refund") @db.Decimal(10, 4)
  updatedAt                      DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model AircraftInstance {
  id                          String             @id @default(uuid()) @db.Uuid
  warehouseAircraftId         String?            @map("warehouse_aircraft_id") @db.Uuid
  prospectId                  String             @map("prospect_id") @db.Uuid
  proposalId                  String?            @map("proposal_id") @db.Uuid
  tailNumber                  String?            @map("tail_number")
  serialNumber                String?            @map("serial_number")
  year                        Int?
  estimatedValue              Decimal?           @map("estimated_value") @db.Decimal(14, 2)
  valueSource                 ValueSource?       @map("value_source")
  currentManager              String?            @map("current_manager")
  currentOperator             String?            @map("current_operator")
  currentHomeBaseIcao         String?            @map("current_home_base_icao")
  proposedHomeBaseIcao        String?            @map("proposed_home_base_icao")
  engineModel                 String?            @map("engine_model")
  apuModel                    String?            @map("apu_model")
  wifiSystem                  String?            @map("wifi_system")
  maintenanceTrackingProvider String?            @map("maintenance_tracking_provider")
  programStatus               String?            @map("program_status")
  interiorCondition           InteriorCondition? @map("interior_condition")
  paintCondition              PaintCondition?    @map("paint_condition")
  knownInspections            String?            @map("known_inspections") @db.Text
  deferredMaintenance         String?            @map("deferred_maintenance") @db.Text
  internalNotes               String?            @map("internal_notes") @db.Text
  clientSummary               String?            @map("client_summary") @db.Text
  portalImageUrl              String?            @map("portal_image_url")
  portalVideoUrl              String?            @map("portal_video_url")
  portalSpecHighlights        Json?              @map("portal_spec_highlights") @db.JsonB
  includedOnProposal          Boolean            @default(true) @map("included_on_proposal")
  fboName                     String?            @map("fbo_name")
  createdAt                   DateTime           @default(now()) @map("created_at")
  updatedAt                   DateTime           @updatedAt @map("updated_at")

  warehouseAircraft WarehouseAircraft? @relation(fields: [warehouseAircraftId], references: [id])
  prospect          Prospect           @relation(fields: [prospectId], references: [id])
  proposal          Proposal?          @relation("ProposalAircraft", fields: [proposalId], references: [id], onDelete: Cascade)
  proposals         Proposal[]         @relation("ProposalPrimaryAircraft")
  scenarios         ProposalScenario[]

  @@map("aircraft_instances")
}

// Global reference data from OurAirports open data (https://ourairports.com/data/)
model CountryReference {
  id            Int      @id @map("ourairports_id")
  code          String   @unique
  name          String
  continent     String?
  wikipediaLink String?  @map("wikipedia_link")
  keywords      String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("country_reference")
}

model RegionReference {
  id            Int      @id @map("ourairports_id")
  code          String   @unique
  localCode     String?  @map("local_code")
  name          String
  continent     String?
  isoCountry    String   @map("iso_country")
  wikipediaLink String?  @map("wikipedia_link")
  keywords      String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isoCountry])
  @@map("region_reference")
}

model AirportReference {
  id               String   @id @default(uuid()) @db.Uuid
  ourairportsId    Int      @unique @map("ourairports_id")
  ident            String   @unique
  icao             String?  @unique
  iata             String?
  airportType      String   @map("airport_type")
  name             String
  latitudeDeg      Decimal? @map("latitude_deg") @db.Decimal(10, 7)
  longitudeDeg     Decimal? @map("longitude_deg") @db.Decimal(10, 7)
  elevationFt      Int?     @map("elevation_ft")
  continent        String?
  isoCountry       String   @map("iso_country")
  isoRegion        String?  @map("iso_region")
  municipality     String?
  scheduledService Boolean  @default(false) @map("scheduled_service")
  gpsCode          String?  @map("gps_code")
  localCode        String?  @map("local_code")
  homeLink         String?  @map("home_link")
  wikipediaLink    String?  @map("wikipedia_link")
  keywords         String?  @db.Text
  longestRunwayFt  Int?     @map("longest_runway_ft")
  sourceVersion    String?  @map("source_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  runways     AirportRunwayReference[]
  frequencies AirportFrequencyReference[]

  @@index([iata])
  @@index([isoCountry])
  @@index([municipality])
  @@index([name])
  @@map("airport_reference")
}

model AirportRunwayReference {
  id                      String   @id @default(uuid()) @db.Uuid
  ourairportsId           Int      @unique @map("ourairports_id")
  airportId               String   @map("airport_id") @db.Uuid
  airportIdent            String   @map("airport_ident")
  lengthFt                Int?     @map("length_ft")
  widthFt                 Int?     @map("width_ft")
  surface                 String?
  lighted                 Boolean  @default(false)
  closed                  Boolean  @default(false)
  leIdent                 String?  @map("le_ident")
  leLatitudeDeg           Decimal? @map("le_latitude_deg") @db.Decimal(10, 7)
  leLongitudeDeg          Decimal? @map("le_longitude_deg") @db.Decimal(10, 7)
  leElevationFt           Int?     @map("le_elevation_ft")
  leHeadingDegT           Int?     @map("le_heading_deg_t")
  leDisplacedThresholdFt  Int?     @map("le_displaced_threshold_ft")
  heIdent                 String?  @map("he_ident")
  heLatitudeDeg           Decimal? @map("he_latitude_deg") @db.Decimal(10, 7)
  heLongitudeDeg          Decimal? @map("he_longitude_deg") @db.Decimal(10, 7)
  heElevationFt           Int?     @map("he_elevation_ft")
  heHeadingDegT           Int?     @map("he_heading_deg_t")
  heDisplacedThresholdFt  Int?     @map("he_displaced_threshold_ft")
  gradientPctVerified     Float?   @map("gradient_pct_verified")
  gradientHighEndVerified String?  @map("gradient_high_end_verified")
  gradientPctEstimated    Float?   @map("gradient_pct_estimated")

  airport AirportReference @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@index([airportId])
  @@index([airportIdent])
  @@map("airport_runway_reference")
}

model AirportFrequencyReference {
  id            String   @id @default(uuid()) @db.Uuid
  ourairportsId Int      @unique @map("ourairports_id")
  airportId     String   @map("airport_id") @db.Uuid
  airportIdent  String   @map("airport_ident")
  type          String
  description   String?
  frequencyMhz  Decimal? @map("frequency_mhz") @db.Decimal(8, 3)

  airport AirportReference @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@index([airportId])
  @@index([airportIdent])
  @@map("airport_frequency_reference")
}

enum UserInviteStatus {
  pending
  accepted
  expired
}

model UserInvite {
  id         String           @id @default(uuid()) @db.Uuid
  email      String
  role       UserRole
  invitedBy  String           @map("invited_by") @db.Uuid
  invitedAt  DateTime         @default(now()) @map("invited_at")
  acceptedAt DateTime?        @map("accepted_at")
  status     UserInviteStatus @default(pending)
  tokenHash  String?          @map("token_hash")

  inviter User @relation("UserInviteSentBy", fields: [invitedBy], references: [id])

  @@map("user_invites")
}

model FeatureOption {
  id                   String          @id @default(uuid()) @db.Uuid
  featureName          String          @map("feature_name")
  featureCategory      String?         @map("feature_category")
  description          String?         @db.Text
  defaultInstallCost   Decimal?        @map("default_install_cost") @db.Decimal(12, 2)
  defaultMonthlyCost   Decimal?        @map("default_monthly_cost") @db.Decimal(12, 2)
  defaultAnnualCost    Decimal?        @map("default_annual_cost") @db.Decimal(12, 2)
  costType             FeatureCostType @map("cost_type")
  clientVisibleDefault Boolean         @default(true) @map("client_visible_default")
  source               String?
  confidence           DataConfidence  @default(medium)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@map("feature_options")
}

model OperatingModel {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  regulatoryModel     String?  @map("regulatory_model")
  charterEnabled      Boolean  @default(false) @map("charter_enabled")
  conformityRequired  Boolean  @default(false) @map("conformity_required")
  crewRequired        Boolean  @default(true) @map("crew_required")
  revenueShareApplies Boolean  @default(false) @map("revenue_share_applies")
  description         String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("operating_models")
}

model Proposal {
  id                 String         @id @default(uuid()) @db.Uuid
  prospectId         String         @map("prospect_id") @db.Uuid
  aircraftInstanceId String?        @map("aircraft_instance_id") @db.Uuid
  proposalName       String         @map("proposal_name")
  status             ProposalStatus @default(draft)
  pipelineStage      PipelineStage  @default(lead_research) @map("pipeline_stage")
  isParked           Boolean        @default(false) @map("is_parked")
  preparedById       String         @map("prepared_by") @db.Uuid
  reviewedById       String?        @map("reviewed_by") @db.Uuid
  approvedById       String?        @map("approved_by") @db.Uuid
  preparedDate       DateTime?      @map("prepared_date") @db.Date
  publishedDate      DateTime?      @map("published_date") @db.Date
  expirationDate     DateTime?      @map("expiration_date") @db.Date
  internalNotes      String?        @map("internal_notes") @db.Text
  clientSummary      String?        @map("client_summary") @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  prospect         Prospect               @relation(fields: [prospectId], references: [id])
  aircraftInstance AircraftInstance?      @relation("ProposalPrimaryAircraft", fields: [aircraftInstanceId], references: [id])
  aircraft         AircraftInstance[]     @relation("ProposalAircraft")
  preparedBy       User                   @relation("ProposalPreparedBy", fields: [preparedById], references: [id])
  reviewedBy       User?                  @relation("ProposalReviewedBy", fields: [reviewedById], references: [id])
  approvedBy       User?                  @relation("ProposalApprovedBy", fields: [approvedById], references: [id])
  assumptions      ProposalAssumption[]
  ownerProfiles    ProposalOwnerProfile[]
  scenarios        ProposalScenario[]
  sections         ProposalSection[]
  snapshots        ProposalSnapshot[]
  clientPortal     ClientPortal?
  clientScenarios  ClientScenario[]
  tasks            ProposalTask[]
  comments         ProposalComment[]

  @@map("proposals")
}

model ProposalOwnerProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  proposalId         String   @map("proposal_id") @db.Uuid
  aircraftInstanceId String   @map("aircraft_instance_id") @db.Uuid
  sortOrder          Int      @default(0) @map("sort_order")
  displayName        String   @map("display_name")
  annualFlightHours  Decimal  @default(0) @map("annual_flight_hours") @db.Decimal(10, 2)
  ownershipPercent   Decimal  @default(100) @map("ownership_percent") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, aircraftInstanceId, sortOrder])
  @@index([proposalId, aircraftInstanceId])
  @@map("proposal_owner_profiles")
}

model ProposalComment {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @map("proposal_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([proposalId, createdAt])
  @@map("proposal_comments")
}

model ProposalAssumption {
  id                String               @id @default(uuid()) @db.Uuid
  proposalId        String               @map("proposal_id") @db.Uuid
  category          String
  assumptionName    String               @map("assumption_name")
  value             String
  unit              String?
  sourceType        AssumptionSourceType @map("source_type")
  sourceId          String?              @map("source_id") @db.Uuid
  confidence        DataConfidence       @default(medium)
  visibleToClient   Boolean              @default(true) @map("visible_to_client")
  editableByClient  Boolean              @default(false) @map("editable_by_client")
  internalNote      String?              @map("internal_note") @db.Text
  clientExplanation String?              @map("client_explanation") @db.Text
  aiGenerated       Boolean              @default(false) @map("ai_generated")
  aiModel           String?              @map("ai_model")
  aiConfidence      Decimal?             @map("ai_confidence") @db.Decimal(5, 4)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, category, assumptionName])
  @@map("proposal_assumptions")
}

model ProposalScenario {
  id                   String   @id @default(uuid()) @db.Uuid
  proposalId           String   @map("proposal_id") @db.Uuid
  aircraftInstanceId   String?  @map("aircraft_instance_id") @db.Uuid
  scenarioName         String   @map("scenario_name")
  scenarioIndex        Int      @default(1) @map("scenario_index")
  isBaseCase           Boolean  @default(true) @map("is_base_case")
  aircraftValue        Decimal? @map("aircraft_value") @db.Decimal(14, 2)
  ownerHours           Decimal? @map("owner_hours") @db.Decimal(10, 2)
  crewStepIndex        Int?     @map("crew_step_index")
  leadPilotEnabled     Boolean? @map("lead_pilot_enabled")
  charterBlockHours    Decimal? @map("charter_block_hours") @db.Decimal(10, 2)
  charterFlightHours   Decimal? @map("charter_flight_hours") @db.Decimal(10, 2)
  totalFixedCosts      Decimal? @map("total_fixed_costs") @db.Decimal(14, 2)
  ownerVariableCosts   Decimal? @map("owner_variable_costs") @db.Decimal(14, 2)
  charterVariableCosts Decimal? @map("charter_variable_costs") @db.Decimal(14, 2)
  totalRevenue         Decimal? @map("total_revenue") @db.Decimal(14, 2)
  netAnnualCost        Decimal? @map("net_annual_cost") @db.Decimal(14, 2)
  netMonthlyCost       Decimal? @map("net_monthly_cost") @db.Decimal(14, 2)
  costPerOwnerHour     Decimal? @map("cost_per_owner_hour") @db.Decimal(14, 2)
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  proposal         Proposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  aircraftInstance AircraftInstance? @relation(fields: [aircraftInstanceId], references: [id], onDelete: Cascade)

  @@unique([proposalId, aircraftInstanceId, scenarioIndex])
  @@map("proposal_scenarios")
}

model ProposalSection {
  id                 String      @id @default(uuid()) @db.Uuid
  proposalId         String      @map("proposal_id") @db.Uuid
  sectionType        SectionType @map("section_type")
  title              String
  bodyCopy           String?     @map("body_copy") @db.Text
  visible            Boolean     @default(true)
  sortOrder          Int         @map("sort_order")
  imageUrl           String?     @map("image_url")
  videoUrl           String?     @map("video_url")
  posterUrl          String?     @map("poster_url")
  calloutMetricLabel String?     @map("callout_metric_label")
  calloutMetricValue String?     @map("callout_metric_value")
  layoutVariant      String?     @map("layout_variant")
  contentBlocks      Json?       @map("content_blocks") @db.JsonB
  signatoryName      String?     @map("signatory_name")
  signatoryTitle     String?     @map("signatory_title")
  internalNotes      String?     @map("internal_notes") @db.Text
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_sections")
}

model ProposalSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  proposalId    String   @map("proposal_id") @db.Uuid
  versionNumber Int      @map("version_number")
  snapshotJson  Json     @map("snapshot_json") @db.JsonB
  publishedById String   @map("published_by") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at")
  notes         String?  @db.Text

  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  publishedBy User     @relation("SnapshotPublishedBy", fields: [publishedById], references: [id])

  @@unique([proposalId, versionNumber])
  @@map("proposal_snapshots")
}

model PortalContent {
  id                  String   @id @default("default")
  heroCloudImageUrl   String?  @map("hero_cloud_image_url")
  heroCloudVideoUrl   String?  @map("hero_cloud_video_url")
  logoUrl             String?  @map("logo_url")
  aboutTitle          String   @default("About PrismJet") @map("about_title")
  aboutBody           String   @default("") @map("about_body") @db.Text
  servicesTitle       String   @default("Our Services") @map("services_title")
  servicesBody        String?  @map("services_body") @db.Text
  servicesPillars     Json     @default("[]") @map("services_pillars") @db.JsonB
  contactTitle        String   @default("Contact") @map("contact_title")
  contactBody         String?  @map("contact_body") @db.Text
  contactEmail        String   @default("info@prismjet.com") @map("contact_email")
  contactPhone        String?  @map("contact_phone")
  fleetTitle          String   @default("Our Aircraft") @map("fleet_title")
  fleetBody           String?  @map("fleet_body") @db.Text
  sectionDefaults     Json?    @map("section_defaults") @db.JsonB
  experienceTemplates Json?    @map("experience_templates") @db.JsonB
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("portal_content")
}

model PortalFleetShowcase {
  id        String   @id @default(uuid()) @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  title     String
  subtitle  String?
  imageUrl  String?  @map("image_url")
  videoUrl  String?  @map("video_url")
  posterUrl String?  @map("poster_url")
  specs     Json?    @db.JsonB
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("portal_fleet_showcase")
}

model ClientPortal {
  id               String    @id @default(uuid()) @db.Uuid
  proposalId       String    @unique @map("proposal_id") @db.Uuid
  slug             String    @unique
  pinHash          String    @map("pin_hash")
  pinCiphertext    String?   @map("pin_ciphertext") @db.Text
  active           Boolean   @default(true)
  expiresAt        DateTime? @map("expires_at")
  viewCount        Int       @default(0) @map("view_count")
  lastViewedAt     DateTime? @map("last_viewed_at")
  pdfDownloadCount Int       @default(0) @map("pdf_download_count")
  emailSentAt      DateTime? @map("email_sent_at")
  emailOpenedAt    DateTime? @map("email_opened_at")
  emailClickCount  Int       @default(0) @map("email_click_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  proposal        Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientScenarios ClientScenario[]

  @@map("client_portals")
}

model ClientScenario {
  id                         String   @id @default(uuid()) @db.Uuid
  proposalId                 String   @map("proposal_id") @db.Uuid
  portalId                   String   @map("portal_id") @db.Uuid
  aircraftValue              Decimal? @map("aircraft_value") @db.Decimal(14, 2)
  ownerHours                 Decimal? @map("owner_hours") @db.Decimal(10, 2)
  calculatedNetAnnualCost    Decimal? @map("calculated_net_annual_cost") @db.Decimal(14, 2)
  calculatedMonthlyCost      Decimal? @map("calculated_monthly_cost") @db.Decimal(14, 2)
  calculatedCostPerOwnerHour Decimal? @map("calculated_cost_per_owner_hour") @db.Decimal(14, 2)
  createdAt                  DateTime @default(now()) @map("created_at")

  proposal Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  portal   ClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@map("client_scenarios")
}

model ProposalTask {
  id         String    @id @default(uuid()) @db.Uuid
  proposalId String    @map("proposal_id") @db.Uuid
  title      String
  status     String    @default("open")
  assignedTo String?   @map("assigned_to") @db.Uuid
  dueDate    DateTime? @map("due_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_tasks")
}

// ——— PrismJet Crew (operational fleet + performance tables) ———

enum CrewFleetStatus {
  active
  retired
}

enum CrewPerformanceMetric {
  takeoffFieldLength
  landingDistance
}

/// Aircraft type catalog for Crew (e.g. B300 / King Air 350).
model CrewAircraftType {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  manufacturer  String
  model         String
  maxPassengers Int?     @map("max_passengers")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  fleet       CrewFleetAircraft[]
  performance CrewPerformanceGrid[]

  @@map("crew_aircraft_types")
}

/// Operational charter tail — independent of sales proposals.
model CrewFleetAircraft {
  id             String          @id @default(uuid()) @db.Uuid
  tailNumber     String          @unique @map("tail_number")
  aircraftTypeId String          @map("aircraft_type_id") @db.Uuid
  status         CrewFleetStatus @default(active)
  homeBase       String?         @map("home_base")
  serialNumber   String?         @map("serial_number")
  operating      Json            @db.JsonB
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  aircraftType          CrewAircraftType      @relation(fields: [aircraftTypeId], references: [id], onDelete: Restrict)
  scheduleEvents        ScheduleEvent[]
  charterRequestMatches CharterRequestMatch[]

  @@index([aircraftTypeId])
  @@map("crew_fleet_aircraft")
}

/// Type-level performance grid (pressure altitude × weight × OAT → length ft).
model CrewPerformanceGrid {
  id                 String                @id @default(uuid()) @db.Uuid
  aircraftTypeId     String                @map("aircraft_type_id") @db.Uuid
  metric             CrewPerformanceMetric
  unit               String                @default("ft")
  pressureAltitudeFt Int[]                 @map("pressure_altitude_ft")
  weightLb           Int[]                 @map("weight_lb")
  oatC               Int[]                 @map("oat_c")
  values             Json                  @db.JsonB
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  aircraftType CrewAircraftType @relation(fields: [aircraftTypeId], references: [id], onDelete: Cascade)

  @@unique([aircraftTypeId, metric])
  @@map("crew_performance_grids")
}

// ——— JetInsight schedule + charter requests ———

enum ScheduleRawEventType {
  charter
  owner
  positioning
  maintenance
  ferry_mx
  training
  other
}

enum ScheduleAvailabilityClass {
  hard_block
  soft_hold
  repo_opportunity
  info_only
}

enum InboundMessageProvider {
  postmark
  manual
}

enum CharterRequestStatus {
  new
  parsed
  matched
  quoted
  sent_to_jetinsight
}

enum CharterRequestParsedBy {
  rules
  ai
}

enum CharterTripType {
  one_way
  round_trip
  multi_city
}

model ScheduleSource {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  icsUrl              String    @map("ics_url")
  pollIntervalMinutes Int       @default(10) @map("poll_interval_minutes")
  lastSyncedAt        DateTime? @map("last_synced_at")
  lastSyncStatus      String?   @map("last_sync_status")
  enabled             Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  events   ScheduleEvent[]
  syncRuns ScheduleSyncRun[]

  @@map("schedule_sources")
}

model ScheduleEvent {
  id                String                    @id @default(uuid()) @db.Uuid
  sourceId          String                    @map("source_id") @db.Uuid
  externalUid       String                    @map("external_uid")
  externalTripCode  String?                   @map("external_trip_code")
  externalUrl       String?                   @map("external_url")
  tailNumber        String                    @map("tail_number")
  fleetAircraftId   String?                   @map("fleet_aircraft_id") @db.Uuid
  depIcao           String?                   @map("dep_icao")
  arrIcao           String?                   @map("arr_icao")
  locationIcao      String?                   @map("location_icao")
  startsAt          DateTime                  @map("starts_at")
  endsAt            DateTime                  @map("ends_at")
  lastModifiedAt    DateTime?                 @map("last_modified_at")
  clientLabel       String?                   @map("client_label")
  paxCount          Int?                      @map("pax_count")
  picName           String?                   @map("pic_name")
  sicName           String?                   @map("sic_name")
  cabinCrew         String[]                  @default([]) @map("cabin_crew")
  summaryRaw        String                    @map("summary_raw")
  descriptionRaw    String?                   @map("description_raw")
  rawEventType      ScheduleRawEventType      @map("raw_event_type")
  isHold            Boolean                   @default(false) @map("is_hold")
  isAdminBlock      Boolean                   @default(false) @map("is_admin_block")
  availabilityClass ScheduleAvailabilityClass @map("availability_class")
  rawIcs            Json                      @default("{}") @map("raw_ics") @db.JsonB
  deletedAt         DateTime?                 @map("deleted_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  source        ScheduleSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fleetAircraft CrewFleetAircraft? @relation(fields: [fleetAircraftId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalUid])
  @@index([tailNumber, startsAt])
  @@index([availabilityClass, startsAt])
  @@map("schedule_events")
}

model ScheduleSyncRun {
  id             String    @id @default(uuid()) @db.Uuid
  sourceId       String    @map("source_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  eventsUpserted Int       @default(0) @map("events_upserted")
  eventsDeleted  Int       @default(0) @map("events_deleted")
  errorMessage   String?   @map("error_message")

  source ScheduleSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt(sort: Desc)])
  @@map("schedule_sync_runs")
}

model InboundMessage {
  id          String                 @id @default(uuid()) @db.Uuid
  provider    InboundMessageProvider
  messageId   String?                @map("message_id")
  fromAddress String                 @map("from_address")
  toAddress   String?                @map("to_address")
  subject     String?
  bodyText    String?                @map("body_text") @db.Text
  bodyHtml    String?                @map("body_html") @db.Text
  rawPayload  Json                   @default("{}") @map("raw_payload") @db.JsonB
  receivedAt  DateTime               @default(now()) @map("received_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  charterRequests CharterRequest[]

  @@index([receivedAt(sort: Desc)])
  @@map("inbound_messages")
}

model CharterRequest {
  id                String                  @id @default(uuid()) @db.Uuid
  inboundMessageId  String?                 @map("inbound_message_id") @db.Uuid
  createdById       String?                 @map("created_by_id") @db.Uuid
  status            CharterRequestStatus    @default(new)
  tripType          CharterTripType         @default(one_way) @map("trip_type")
  source            String                  @default("manual")
  flightCategory    String?                 @map("flight_category")
  requestedDepIcao  String?                 @map("requested_dep_icao")
  requestedArrIcao  String?                 @map("requested_arr_icao")
  requestedDepartAt DateTime?               @map("requested_depart_at")
  paxCount          Int?                    @map("pax_count")
  clientName        String?                 @map("client_name")
  notes             String?                 @db.Text
  parseConfidence   Decimal?                @map("parse_confidence") @db.Decimal(5, 4)
  parsedBy          CharterRequestParsedBy? @map("parsed_by")
  rawExtraction     Json                    @default("{}") @map("raw_extraction") @db.JsonB
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  inboundMessage InboundMessage?       @relation(fields: [inboundMessageId], references: [id], onDelete: SetNull)
  createdBy      User?                 @relation("CharterRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  legs           CharterRequestLeg[]
  matches        CharterRequestMatch[]

  @@index([status, createdAt(sort: Desc)])
  @@map("charter_requests")
}

model CharterRequestLeg {
  id         String    @id @default(uuid()) @db.Uuid
  requestId  String    @map("request_id") @db.Uuid
  legIndex   Int       @map("leg_index")
  depIcao    String    @map("dep_icao")
  arrIcao    String    @map("arr_icao")
  departAt   DateTime? @map("depart_at")
  timeTbd    Boolean   @default(false) @map("time_tbd")
  departPref String?   @map("depart_pref")
  createdAt  DateTime  @default(now()) @map("created_at")

  request CharterRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, legIndex])
  @@map("charter_request_legs")
}

model CharterRequestMatch {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @map("request_id") @db.Uuid
  tailNumber      String   @map("tail_number")
  fleetAircraftId String?  @map("fleet_aircraft_id") @db.Uuid
  score           Decimal  @db.Decimal(8, 4)
  rank            Int
  reasoning       Json     @default("{}") @db.JsonB
  recommended     Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  request       CharterRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fleetAircraft CrewFleetAircraft? @relation(fields: [fleetAircraftId], references: [id], onDelete: SetNull)

  @@index([requestId, rank])
  @@map("charter_request_matches")
}
