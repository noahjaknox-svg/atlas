generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  sales
  reviewer
}

enum ProspectType {
  individual_owner
  company_owner
  family_office
  broker_referral
  aircraft_buyer
  existing_client
  other
}

enum OpportunityType {
  aircraft_management
  management_with_charter
  part91_only
  acquisition_support
  transition
  charter_optimization
  shared_ownership
  other
}

enum DataConfidence {
  low
  medium
  high
}

enum AircraftCategory {
  light_jet
  midsize_jet
  super_midsize_jet
  large_cabin_jet
  ultra_long_range_jet
  turboprop
  piston
  helicopter
  other
}

enum ValueSource {
  owner_provided
  broker_estimate
  vref
  aircraft_bluebook
  jetnet
  amstat
  internal_estimate
  appraisal
  other
}

enum InteriorCondition {
  excellent
  good
  fair
  needs_refurb
}

enum PaintCondition {
  excellent
  good
  fair
  needs_repaint
}

enum CrewRole {
  pic
  sic
  cabin_attendant
}

enum TrainingType {
  initial
  recurrent
}

enum ProgramType {
  engine
  apu
  parts
  airframe
  avionics
  other
}

enum FeatureCostType {
  one_time
  monthly
  annual
}

enum HangarPricingMethod {
  quoted
  sqft_rate
  category_estimate
}

enum ProposalStatus {
  draft
  internal_review
  approved
  published
  viewed
  revised
  won
  lost
}

enum PipelineStage {
  lead_research
  building
  internal_review
  client_review
  closed
}

enum AssumptionSourceType {
  manual
  reference_table
  calculated
  default
}

enum SectionType {
  cover
  executive_summary
  aircraft_overview
  management_approach
  operating_assumptions
  charter_strategy
  pro_forma
  cost_breakdown
  transition_plan
  team
  next_steps
  disclaimer
  welcome
  about_us
  aircraft_management
  aircraft_charter
  maintenance
  sales_acquisitions
  conformity_process
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String?  @map("password_hash")
  supabaseId   String?  @unique @map("supabase_id")
  role         UserRole @default(sales)
  active       Boolean  @default(true)
  permissions  Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  prospectsCreated   Prospect[]         @relation("ProspectCreatedBy")
  prospectsAssigned  Prospect[]         @relation("ProspectAssignedTo")
  invitesSent        UserInvite[]       @relation("UserInviteSentBy")
  fboOverrides       FboLocation[]      @relation("FboOverrideBy")
  proposalsPrepared Proposal[]        @relation("ProposalPreparedBy")
  proposalsReviewed Proposal[]         @relation("ProposalReviewedBy")
  proposalsApproved Proposal[]         @relation("ProposalApprovedBy")
  snapshotsPublished ProposalSnapshot[] @relation("SnapshotPublishedBy")
  proposalComments   ProposalComment[]

  @@map("users")
}

model Prospect {
  id              String          @id @default(uuid()) @db.Uuid
  prospectName    String          @map("prospect_name")
  companyName     String?         @map("company_name")
  contactName     String          @map("contact_name")
  contactEmail    String          @map("contact_email")
  contactPhone    String?         @map("contact_phone")
  prospectType    ProspectType    @map("prospect_type")
  currentManager  String?         @map("current_manager")
  opportunityType OpportunityType @map("opportunity_type")
  internalNotes   String?         @map("internal_notes") @db.Text
  clientSummary   String?         @map("client_summary") @db.Text
  createdById     String          @map("created_by") @db.Uuid
  pipelineStatus  String?         @map("pipeline_status")
  followUpDate    DateTime?       @map("follow_up_date") @db.Date
  assignedToId    String?         @map("assigned_to") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  createdBy  User              @relation("ProspectCreatedBy", fields: [createdById], references: [id])
  assignedTo User?             @relation("ProspectAssignedTo", fields: [assignedToId], references: [id])
  aircraft   AircraftInstance[]
  proposals  Proposal[]

  @@map("prospects")
}

model AircraftMaster {
  id                         String           @id @default(uuid()) @db.Uuid
  manufacturer               String
  model                      String
  variant                    String?
  aircraftCategory           AircraftCategory @map("aircraft_category")
  typicalCrewRequired        Int?             @map("typical_crew_required")
  typicalFuelBurnGph         Decimal?         @map("typical_fuel_burn_gph") @db.Decimal(10, 2)
  typicalCruiseSpeedKtas     Int?             @map("typical_cruise_speed_ktas")
  typicalRangeNm             Int?             @map("typical_range_nm")
  typicalPassengerCapacity   Int?             @map("typical_passenger_capacity")
  typicalCharterRate         Decimal?         @map("typical_charter_rate") @db.Decimal(12, 2)
  maxRecommendedUtilization  Int?             @map("max_recommended_utilization_hours")
  defaultEngineModel         String?          @map("default_engine_model")
  defaultApuModel            String?          @map("default_apu_model")
  dataConfidence             DataConfidence   @default(medium) @map("data_confidence")
  sourceNotes                String?          @map("source_notes") @db.Text
  externalId                 String?          @map("external_id")
  externalSource             String?          @map("external_source")
  cabinSqft                  Int?             @map("cabin_sqft")
  typicalHullValue           Decimal?         @map("typical_hull_value") @db.Decimal(14, 2)
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  instances         AircraftInstance[]
  crewRates         CrewRate[]
  trainingCosts     TrainingCost[]
  insurance         InsuranceAssumption[]
  programCosts      ProgramCost[]
  charterRates      CharterMarketRate[]
  hangarCosts       HangarCost[]
  operatingDefaults AircraftOperatingDefault[]
  scenarioTemplates ScenarioTemplate[]

  @@map("aircraft_master")
}

model AircraftInstance {
  id                          String            @id @default(uuid()) @db.Uuid
  aircraftMasterId            String?           @map("aircraft_master_id") @db.Uuid
  prospectId                  String            @map("prospect_id") @db.Uuid
  proposalId                  String?           @map("proposal_id") @db.Uuid
  tailNumber                  String?           @map("tail_number")
  serialNumber                String?           @map("serial_number")
  year                        Int?
  estimatedValue              Decimal?          @map("estimated_value") @db.Decimal(14, 2)
  valueSource                 ValueSource?      @map("value_source")
  currentManager              String?           @map("current_manager")
  currentOperator             String?           @map("current_operator")
  currentHomeBaseIcao         String?           @map("current_home_base_icao")
  proposedHomeBaseIcao        String?           @map("proposed_home_base_icao")
  engineModel                 String?           @map("engine_model")
  apuModel                    String?           @map("apu_model")
  wifiSystem                  String?           @map("wifi_system")
  maintenanceTrackingProvider String?           @map("maintenance_tracking_provider")
  programStatus               String?           @map("program_status")
  interiorCondition           InteriorCondition? @map("interior_condition")
  paintCondition              PaintCondition?   @map("paint_condition")
  knownInspections            String?           @map("known_inspections") @db.Text
  deferredMaintenance         String?           @map("deferred_maintenance") @db.Text
  internalNotes               String?           @map("internal_notes") @db.Text
  clientSummary               String?           @map("client_summary") @db.Text
  portalImageUrl              String?           @map("portal_image_url")
  portalVideoUrl              String?           @map("portal_video_url")
  portalSpecHighlights        Json?             @map("portal_spec_highlights") @db.JsonB
  includedOnProposal          Boolean           @default(true) @map("included_on_proposal")
  fboName                     String?           @map("fbo_name")
  createdAt                   DateTime          @default(now()) @map("created_at")
  updatedAt                   DateTime          @updatedAt @map("updated_at")

  aircraftMaster AircraftMaster? @relation(fields: [aircraftMasterId], references: [id])
  prospect       Prospect        @relation(fields: [prospectId], references: [id])
  proposal       Proposal?         @relation("ProposalAircraft", fields: [proposalId], references: [id], onDelete: Cascade)
  proposals      Proposal[]        @relation("ProposalPrimaryAircraft")
  scenarios      ProposalScenario[]

  @@map("aircraft_instances")
}

model Airport {
  id              String   @id @default(uuid()) @db.Uuid
  icao            String   @unique
  iata            String?
  airportName     String   @map("airport_name")
  city            String?
  state           String?
  country         String?
  timezone        String?
  runwayLengthFt  Int?     @map("runway_length_ft")
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  fuelPrices         FuelPrice[]
  hangarCosts        HangarCost[]
  crewRates          CrewRate[]
  charterRates       CharterMarketRate[]
  fboLocations       FboLocation[]
  airportFeeSchedules AirportFeeSchedule[]

  @@map("airports")
}

// Global reference data from OurAirports open data (https://ourairports.com/data/)
model CountryReference {
  id             Int      @id @map("ourairports_id")
  code           String   @unique
  name           String
  continent      String?
  wikipediaLink  String?  @map("wikipedia_link")
  keywords       String?  @db.Text
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("country_reference")
}

model RegionReference {
  id             Int      @id @map("ourairports_id")
  code           String   @unique
  localCode      String?  @map("local_code")
  name           String
  continent      String?
  isoCountry     String   @map("iso_country")
  wikipediaLink  String?  @map("wikipedia_link")
  keywords       String?  @db.Text
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isoCountry])
  @@map("region_reference")
}

model AirportReference {
  id               String   @id @default(uuid()) @db.Uuid
  ourairportsId    Int      @unique @map("ourairports_id")
  ident            String   @unique
  icao             String?  @unique
  iata             String?
  airportType      String   @map("airport_type")
  name             String
  latitudeDeg      Decimal? @map("latitude_deg") @db.Decimal(10, 7)
  longitudeDeg     Decimal? @map("longitude_deg") @db.Decimal(10, 7)
  elevationFt      Int?     @map("elevation_ft")
  continent        String?
  isoCountry       String   @map("iso_country")
  isoRegion        String?  @map("iso_region")
  municipality     String?
  scheduledService Boolean  @default(false) @map("scheduled_service")
  gpsCode          String?  @map("gps_code")
  localCode        String?  @map("local_code")
  homeLink         String?  @map("home_link")
  wikipediaLink    String?  @map("wikipedia_link")
  keywords         String?  @db.Text
  longestRunwayFt  Int?     @map("longest_runway_ft")
  sourceVersion    String?  @map("source_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  runways     AirportRunwayReference[]
  frequencies AirportFrequencyReference[]

  @@index([iata])
  @@index([isoCountry])
  @@index([municipality])
  @@index([name])
  @@map("airport_reference")
}

model AirportRunwayReference {
  id                     String   @id @default(uuid()) @db.Uuid
  ourairportsId          Int      @unique @map("ourairports_id")
  airportId              String   @map("airport_id") @db.Uuid
  airportIdent           String   @map("airport_ident")
  lengthFt               Int?     @map("length_ft")
  widthFt                Int?     @map("width_ft")
  surface                String?
  lighted                Boolean  @default(false)
  closed                 Boolean  @default(false)
  leIdent                String?  @map("le_ident")
  leLatitudeDeg          Decimal? @map("le_latitude_deg") @db.Decimal(10, 7)
  leLongitudeDeg         Decimal? @map("le_longitude_deg") @db.Decimal(10, 7)
  leElevationFt          Int?     @map("le_elevation_ft")
  leHeadingDegT          Int?     @map("le_heading_deg_t")
  leDisplacedThresholdFt Int?     @map("le_displaced_threshold_ft")
  heIdent                String?  @map("he_ident")
  heLatitudeDeg          Decimal? @map("he_latitude_deg") @db.Decimal(10, 7)
  heLongitudeDeg         Decimal? @map("he_longitude_deg") @db.Decimal(10, 7)
  heElevationFt          Int?     @map("he_elevation_ft")
  heHeadingDegT          Int?     @map("he_heading_deg_t")
  heDisplacedThresholdFt Int?     @map("he_displaced_threshold_ft")
  gradientPctVerified    Float?   @map("gradient_pct_verified")
  gradientHighEndVerified String? @map("gradient_high_end_verified")
  gradientPctEstimated   Float?   @map("gradient_pct_estimated")

  airport AirportReference @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@index([airportId])
  @@index([airportIdent])
  @@map("airport_runway_reference")
}

model AirportFrequencyReference {
  id            String @id @default(uuid()) @db.Uuid
  ourairportsId Int    @unique @map("ourairports_id")
  airportId     String @map("airport_id") @db.Uuid
  airportIdent  String @map("airport_ident")
  type          String
  description   String?
  frequencyMhz  Decimal? @map("frequency_mhz") @db.Decimal(8, 3)

  airport AirportReference @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@index([airportId])
  @@index([airportIdent])
  @@map("airport_frequency_reference")
}

enum UserInviteStatus {
  pending
  accepted
  expired
}

model UserInvite {
  id         String           @id @default(uuid()) @db.Uuid
  email      String
  role       UserRole
  invitedBy  String           @map("invited_by") @db.Uuid
  invitedAt  DateTime         @default(now()) @map("invited_at")
  acceptedAt DateTime?        @map("accepted_at")
  status     UserInviteStatus @default(pending)
  tokenHash  String?          @map("token_hash")

  inviter User @relation("UserInviteSentBy", fields: [invitedBy], references: [id])

  @@map("user_invites")
}

model FboLocation {
  id                 String    @id @default(uuid()) @db.Uuid
  airportId          String    @map("airport_id") @db.Uuid
  fboName            String    @map("fbo_name")
  phone              String?
  website            String?
  jetARetailPrice    Decimal?  @map("jet_a_retail_price") @db.Decimal(10, 4)
  jetAContractPrice  Decimal?  @map("jet_a_contract_price") @db.Decimal(10, 4)
  lastPriceUpdate    DateTime? @map("last_price_update")
  source             String    @default("manual")
  manualOverride     Boolean   @default(false) @map("manual_override")
  manualOverrideBy   String?   @map("manual_override_by") @db.Uuid
  manualOverrideAt   DateTime? @map("manual_override_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  airport        Airport @relation(fields: [airportId], references: [id], onDelete: Cascade)
  overrideByUser User?   @relation("FboOverrideBy", fields: [manualOverrideBy], references: [id])
  hangarCosts    HangarCost[]

  @@map("fbo_locations")
}

model FuelIndexSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  indexName       String   @map("index_name")
  pricePerGallon  Decimal  @map("price_per_gallon") @db.Decimal(10, 4)
  effectiveDate   DateTime @map("effective_date") @db.Date
  sourceUrl       String?  @map("source_url")
  fetchedAt       DateTime @default(now()) @map("fetched_at")

  @@map("fuel_index_snapshots")
}

model FuelPrice {
  id                String         @id @default(uuid()) @db.Uuid
  airportId         String         @map("airport_id") @db.Uuid
  fuelType          String         @map("fuel_type")
  homeFuelPrice     Decimal?       @map("home_fuel_price") @db.Decimal(10, 4)
  contractFuelPrice Decimal?       @map("contract_fuel_price") @db.Decimal(10, 4)
  retailFuelPrice   Decimal?       @map("retail_fuel_price") @db.Decimal(10, 4)
  source            String?
  confidence        DataConfidence @default(medium)
  effectiveDate     DateTime?      @map("effective_date") @db.Date
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  airport Airport @relation(fields: [airportId], references: [id])

  @@map("fuel_prices")
}

model HangarCost {
  id                String              @id @default(uuid()) @db.Uuid
  airportId         String              @map("airport_id") @db.Uuid
  aircraftCategory  AircraftCategory    @map("aircraft_category")
  aircraftMasterId  String?             @map("aircraft_master_id") @db.Uuid
  fboLocationId     String?             @map("fbo_location_id") @db.Uuid
  provider          String?
  pricingMethod     HangarPricingMethod @default(category_estimate) @map("pricing_method")
  quotedAnnual      Decimal?            @map("quoted_annual") @db.Decimal(12, 2)
  ratePerSqftAnnual Decimal?            @map("rate_per_sqft_annual") @db.Decimal(10, 4)
  monthlyCostLow    Decimal?            @map("monthly_cost_low") @db.Decimal(12, 2)
  monthlyCostBase   Decimal?            @map("monthly_cost_base") @db.Decimal(12, 2)
  monthlyCostHigh   Decimal?            @map("monthly_cost_high") @db.Decimal(12, 2)
  source            String?
  confidence        DataConfidence      @default(medium)
  effectiveDate     DateTime?           @map("effective_date") @db.Date
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  airport        Airport         @relation(fields: [airportId], references: [id])
  aircraftMaster AircraftMaster? @relation(fields: [aircraftMasterId], references: [id])
  fboLocation    FboLocation?    @relation(fields: [fboLocationId], references: [id])

  @@index([airportId, aircraftMasterId, fboLocationId])
  @@map("hangar_costs")
}

model AircraftOperatingDefault {
  id               String         @id @default(uuid()) @db.Uuid
  aircraftMasterId String         @map("aircraft_master_id") @db.Uuid
  costKey          String         @map("cost_key")
  annualAmount     Decimal        @map("annual_amount") @db.Decimal(12, 2)
  source           String?
  confidence       DataConfidence @default(medium)
  effectiveDate    DateTime?      @map("effective_date") @db.Date
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  aircraftMaster AircraftMaster @relation(fields: [aircraftMasterId], references: [id], onDelete: Cascade)

  @@unique([aircraftMasterId, costKey, effectiveDate])
  @@map("aircraft_operating_defaults")
}

model AirportFeeSchedule {
  id            String    @id @default(uuid()) @db.Uuid
  airportId     String    @map("airport_id") @db.Uuid
  annualFee     Decimal   @map("annual_fee") @db.Decimal(12, 2)
  source        String?
  effectiveDate DateTime? @map("effective_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  airport Airport @relation(fields: [airportId], references: [id], onDelete: Cascade)

  @@unique([airportId, effectiveDate])
  @@map("airport_fee_schedules")
}

model CrewRate {
  id                String         @id @default(uuid()) @db.Uuid
  aircraftMasterId  String         @map("aircraft_master_id") @db.Uuid
  airportId         String?        @map("airport_id") @db.Uuid
  region            String?
  role              CrewRole
  salaryLow         Decimal?       @map("salary_low") @db.Decimal(12, 2)
  salaryBase        Decimal?       @map("salary_base") @db.Decimal(12, 2)
  salaryHigh        Decimal?       @map("salary_high") @db.Decimal(12, 2)
  benefitsPercent   Decimal?       @map("benefits_percent") @db.Decimal(5, 2)
  payrollTaxPercent Decimal?       @map("payroll_tax_percent") @db.Decimal(5, 2)
  bonusEstimate     Decimal?       @map("bonus_estimate") @db.Decimal(12, 2)
  source            String?
  confidence        DataConfidence @default(medium)
  effectiveDate     DateTime?      @map("effective_date") @db.Date
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  aircraftMaster AircraftMaster @relation(fields: [aircraftMasterId], references: [id])
  airport        Airport?       @relation(fields: [airportId], references: [id])

  @@map("crew_rates")
}

model TrainingCost {
  id               String         @id @default(uuid()) @db.Uuid
  aircraftMasterId String         @map("aircraft_master_id") @db.Uuid
  role             CrewRole
  trainingType     TrainingType   @map("training_type")
  provider         String?
  annualCost       Decimal?       @map("annual_cost") @db.Decimal(12, 2)
  travelCost       Decimal?       @map("travel_cost") @db.Decimal(12, 2)
  daysRequired     Int?           @map("days_required")
  source           String?
  confidence       DataConfidence @default(medium)
  effectiveDate    DateTime?      @map("effective_date") @db.Date
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  aircraftMaster AircraftMaster @relation(fields: [aircraftMasterId], references: [id])

  @@map("training_costs")
}

model InsuranceAssumption {
  id                     String         @id @default(uuid()) @db.Uuid
  aircraftMasterId       String         @map("aircraft_master_id") @db.Uuid
  state                  String?
  operationType          String?        @map("operation_type")
  hullValueLow           Decimal?       @map("hull_value_low") @db.Decimal(14, 2)
  hullValueHigh          Decimal?       @map("hull_value_high") @db.Decimal(14, 2)
  liabilityLimit         Decimal?       @map("liability_limit") @db.Decimal(14, 2)
  estimatedPremiumPercent Decimal?      @map("estimated_premium_percent") @db.Decimal(6, 4)
  annualPremiumEstimate  Decimal?       @map("annual_premium_estimate") @db.Decimal(12, 2)
  source                 String?
  confidence             DataConfidence @default(medium)
  effectiveDate          DateTime?      @map("effective_date") @db.Date
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  aircraftMaster AircraftMaster @relation(fields: [aircraftMasterId], references: [id])

  @@map("insurance_assumptions")
}

model StateCostFactor {
  id                           String    @id @default(uuid()) @db.Uuid
  state                        String    @unique
  registrationTaxRatePct       Decimal?  @map("registration_tax_rate_pct") @db.Decimal(6, 4)
  jetFuelTaxDifferentialPerGal Decimal?  @map("jet_fuel_tax_differential_per_gal") @db.Decimal(6, 4)
  registrationNotes            String?   @map("registration_notes") @db.Text
  taxNotes                     String?   @map("tax_notes") @db.Text
  insuranceTaxNotes            String?   @map("insurance_tax_notes") @db.Text
  propertyTaxNotes             String?   @map("property_tax_notes") @db.Text
  salesUseTaxNotes             String?   @map("sales_use_tax_notes") @db.Text
  source                       String?
  lastReviewed                 DateTime? @map("last_reviewed") @db.Date
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  @@map("state_cost_factors")
}

model ScenarioTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  aircraftMasterId String   @map("aircraft_master_id") @db.Uuid
  description      String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  aircraftMaster AircraftMaster              @relation(fields: [aircraftMasterId], references: [id], onDelete: Cascade)
  assumptions    ScenarioTemplateAssumption[]

  @@map("scenario_templates")
}

model ScenarioTemplateAssumption {
  id             String   @id @default(uuid()) @db.Uuid
  templateId     String   @map("template_id") @db.Uuid
  assumptionKey  String   @map("assumption_key")
  value          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  template ScenarioTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, assumptionKey])
  @@map("scenario_template_assumptions")
}

model ProgramCost {
  id                  String         @id @default(uuid()) @db.Uuid
  aircraftMasterId    String         @map("aircraft_master_id") @db.Uuid
  programType         ProgramType    @map("program_type")
  provider            String?
  hourlyRate          Decimal?       @map("hourly_rate") @db.Decimal(10, 2)
  minimumAnnualHours  Int?           @map("minimum_annual_hours")
  annualMinimumCost   Decimal?       @map("annual_minimum_cost") @db.Decimal(12, 2)
  catchupCost         Decimal?       @map("catchup_cost") @db.Decimal(12, 2)
  transferCost        Decimal?       @map("transfer_cost") @db.Decimal(12, 2)
  source              String?
  confidence          DataConfidence @default(medium)
  effectiveDate       DateTime?      @map("effective_date") @db.Date
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  aircraftMaster AircraftMaster @relation(fields: [aircraftMasterId], references: [id])

  @@map("program_costs")
}

model FeatureOption {
  id                    String          @id @default(uuid()) @db.Uuid
  featureName           String          @map("feature_name")
  featureCategory       String?         @map("feature_category")
  description           String?         @db.Text
  defaultInstallCost    Decimal?        @map("default_install_cost") @db.Decimal(12, 2)
  defaultMonthlyCost    Decimal?        @map("default_monthly_cost") @db.Decimal(12, 2)
  defaultAnnualCost     Decimal?        @map("default_annual_cost") @db.Decimal(12, 2)
  costType              FeatureCostType @map("cost_type")
  clientVisibleDefault  Boolean         @default(true) @map("client_visible_default")
  source                String?
  confidence            DataConfidence  @default(medium)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  @@map("feature_options")
}

model OperatingModel {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  regulatoryModel       String?  @map("regulatory_model")
  charterEnabled        Boolean  @default(false) @map("charter_enabled")
  conformityRequired    Boolean  @default(false) @map("conformity_required")
  crewRequired          Boolean  @default(true) @map("crew_required")
  revenueShareApplies   Boolean  @default(false) @map("revenue_share_applies")
  description           String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("operating_models")
}

model CharterMarketRate {
  id                  String         @id @default(uuid()) @db.Uuid
  aircraftMasterId    String         @map("aircraft_master_id") @db.Uuid
  airportId           String?        @map("airport_id") @db.Uuid
  region              String?
  retailRateLow       Decimal?       @map("retail_rate_low") @db.Decimal(12, 2)
  retailRateBase      Decimal?       @map("retail_rate_base") @db.Decimal(12, 2)
  retailRateHigh      Decimal?       @map("retail_rate_high") @db.Decimal(12, 2)
  wholesaleRate       Decimal?       @map("wholesale_rate") @db.Decimal(12, 2)
  fuelSurcharge       Decimal?       @map("fuel_surcharge") @db.Decimal(10, 2)
  ownerPaybackPercent Decimal?       @map("owner_payback_percent") @db.Decimal(5, 2)
  source              String?
  confidence          DataConfidence @default(medium)
  effectiveDate       DateTime?      @map("effective_date") @db.Date
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  aircraftMaster AircraftMaster @relation(fields: [aircraftMasterId], references: [id])
  airport        Airport?       @relation(fields: [airportId], references: [id])

  @@map("charter_market_rates")
}

model Proposal {
  id                 String         @id @default(uuid()) @db.Uuid
  prospectId         String         @map("prospect_id") @db.Uuid
  aircraftInstanceId String?        @map("aircraft_instance_id") @db.Uuid
  proposalName       String         @map("proposal_name")
  status             ProposalStatus @default(draft)
  pipelineStage      PipelineStage  @default(lead_research) @map("pipeline_stage")
  isParked           Boolean        @default(false) @map("is_parked")
  preparedById       String         @map("prepared_by") @db.Uuid
  reviewedById       String?        @map("reviewed_by") @db.Uuid
  approvedById       String?        @map("approved_by") @db.Uuid
  preparedDate       DateTime?      @map("prepared_date") @db.Date
  publishedDate      DateTime?      @map("published_date") @db.Date
  expirationDate     DateTime?      @map("expiration_date") @db.Date
  internalNotes      String?        @map("internal_notes") @db.Text
  clientSummary      String?        @map("client_summary") @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  prospect         Prospect            @relation(fields: [prospectId], references: [id])
  aircraftInstance AircraftInstance?   @relation("ProposalPrimaryAircraft", fields: [aircraftInstanceId], references: [id])
  aircraft         AircraftInstance[]  @relation("ProposalAircraft")
  preparedBy       User                @relation("ProposalPreparedBy", fields: [preparedById], references: [id])
  reviewedBy       User?               @relation("ProposalReviewedBy", fields: [reviewedById], references: [id])
  approvedBy       User?               @relation("ProposalApprovedBy", fields: [approvedById], references: [id])
  assumptions      ProposalAssumption[]
  ownerProfiles    ProposalOwnerProfile[]
  scenarios        ProposalScenario[]
  sections         ProposalSection[]
  snapshots        ProposalSnapshot[]
  clientPortal     ClientPortal?
  clientScenarios  ClientScenario[]
  tasks            ProposalTask[]
  comments         ProposalComment[]

  @@map("proposals")
}

model ProposalOwnerProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  proposalId         String   @map("proposal_id") @db.Uuid
  aircraftInstanceId String   @map("aircraft_instance_id") @db.Uuid
  sortOrder          Int      @default(0) @map("sort_order")
  displayName        String   @map("display_name")
  annualFlightHours  Decimal  @default(0) @map("annual_flight_hours") @db.Decimal(10, 2)
  ownershipPercent   Decimal  @default(100) @map("ownership_percent") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, aircraftInstanceId, sortOrder])
  @@index([proposalId, aircraftInstanceId])
  @@map("proposal_owner_profiles")
}

model ProposalComment {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @map("proposal_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([proposalId, createdAt])
  @@map("proposal_comments")
}

model ProposalAssumption {
  id                 String               @id @default(uuid()) @db.Uuid
  proposalId         String               @map("proposal_id") @db.Uuid
  category           String
  assumptionName     String               @map("assumption_name")
  value              String
  unit               String?
  sourceType         AssumptionSourceType @map("source_type")
  sourceId           String?              @map("source_id") @db.Uuid
  confidence         DataConfidence       @default(medium)
  visibleToClient    Boolean              @default(true) @map("visible_to_client")
  editableByClient   Boolean              @default(false) @map("editable_by_client")
  internalNote       String?              @map("internal_note") @db.Text
  clientExplanation  String?              @map("client_explanation") @db.Text
  aiGenerated        Boolean              @default(false) @map("ai_generated")
  aiModel            String?              @map("ai_model")
  aiConfidence       Decimal?             @map("ai_confidence") @db.Decimal(5, 4)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, category, assumptionName])
  @@map("proposal_assumptions")
}

model ProposalScenario {
  id                    String   @id @default(uuid()) @db.Uuid
  proposalId            String   @map("proposal_id") @db.Uuid
  aircraftInstanceId    String?  @map("aircraft_instance_id") @db.Uuid
  scenarioName          String   @map("scenario_name")
  scenarioIndex         Int      @default(1) @map("scenario_index")
  isBaseCase            Boolean  @default(true) @map("is_base_case")
  aircraftValue         Decimal? @map("aircraft_value") @db.Decimal(14, 2)
  ownerHours            Decimal? @map("owner_hours") @db.Decimal(10, 2)
  charterBlockHours     Decimal? @map("charter_block_hours") @db.Decimal(10, 2)
  charterFlightHours    Decimal? @map("charter_flight_hours") @db.Decimal(10, 2)
  totalFixedCosts       Decimal? @map("total_fixed_costs") @db.Decimal(14, 2)
  ownerVariableCosts    Decimal? @map("owner_variable_costs") @db.Decimal(14, 2)
  charterVariableCosts  Decimal? @map("charter_variable_costs") @db.Decimal(14, 2)
  totalRevenue          Decimal? @map("total_revenue") @db.Decimal(14, 2)
  netAnnualCost         Decimal? @map("net_annual_cost") @db.Decimal(14, 2)
  netMonthlyCost        Decimal? @map("net_monthly_cost") @db.Decimal(14, 2)
  costPerOwnerHour      Decimal? @map("cost_per_owner_hour") @db.Decimal(14, 2)
  notes                 String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  proposal         Proposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  aircraftInstance AircraftInstance? @relation(fields: [aircraftInstanceId], references: [id], onDelete: Cascade)

  @@unique([proposalId, aircraftInstanceId, scenarioIndex])
  @@map("proposal_scenarios")
}

model ProposalSection {
  id                  String      @id @default(uuid()) @db.Uuid
  proposalId          String      @map("proposal_id") @db.Uuid
  sectionType         SectionType @map("section_type")
  title               String
  bodyCopy            String?     @map("body_copy") @db.Text
  visible             Boolean     @default(true)
  sortOrder           Int         @map("sort_order")
  imageUrl            String?     @map("image_url")
  videoUrl            String?     @map("video_url")
  posterUrl           String?     @map("poster_url")
  calloutMetricLabel  String?     @map("callout_metric_label")
  calloutMetricValue  String?     @map("callout_metric_value")
  layoutVariant       String?     @map("layout_variant")
  contentBlocks       Json?       @map("content_blocks") @db.JsonB
  signatoryName       String?     @map("signatory_name")
  signatoryTitle      String?     @map("signatory_title")
  internalNotes       String?     @map("internal_notes") @db.Text
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_sections")
}

model ProposalSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  proposalId     String   @map("proposal_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  snapshotJson   Json     @map("snapshot_json") @db.JsonB
  publishedById  String   @map("published_by") @db.Uuid
  publishedAt    DateTime @default(now()) @map("published_at")
  notes          String?  @db.Text

  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  publishedBy User     @relation("SnapshotPublishedBy", fields: [publishedById], references: [id])

  @@unique([proposalId, versionNumber])
  @@map("proposal_snapshots")
}

model PortalContent {
  id                 String   @id @default("default")
  heroCloudImageUrl  String?  @map("hero_cloud_image_url")
  heroCloudVideoUrl  String?  @map("hero_cloud_video_url")
  logoUrl            String?  @map("logo_url")
  aboutTitle         String   @default("About PrismJet") @map("about_title")
  aboutBody          String   @default("") @map("about_body") @db.Text
  servicesTitle      String   @default("Our Services") @map("services_title")
  servicesBody       String?  @map("services_body") @db.Text
  servicesPillars    Json     @default("[]") @map("services_pillars") @db.JsonB
  contactTitle       String   @default("Contact") @map("contact_title")
  contactBody        String?  @map("contact_body") @db.Text
  contactEmail       String   @default("info@prismjet.com") @map("contact_email")
  contactPhone       String?  @map("contact_phone")
  fleetTitle         String   @default("Our Aircraft") @map("fleet_title")
  fleetBody          String?  @map("fleet_body") @db.Text
