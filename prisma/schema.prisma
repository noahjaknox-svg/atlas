model PortalFleetShowcase {
  id        String   @id @default(uuid()) @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  title     String
  subtitle  String?
  imageUrl  String?  @map("image_url")
  videoUrl  String?  @map("video_url")
  posterUrl String?  @map("poster_url")
  specs     Json?    @db.JsonB
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("portal_fleet_showcase")
}

model ClientPortal {
  id                String    @id @default(uuid()) @db.Uuid
  proposalId        String    @unique @map("proposal_id") @db.Uuid
  slug              String    @unique
  pinHash           String    @map("pin_hash")
  pinCiphertext     String?   @map("pin_ciphertext") @db.Text
  active            Boolean   @default(true)
  expiresAt         DateTime? @map("expires_at")
  viewCount         Int       @default(0) @map("view_count")
  lastViewedAt      DateTime? @map("last_viewed_at")
  pdfDownloadCount  Int       @default(0) @map("pdf_download_count")
  emailSentAt       DateTime? @map("email_sent_at")
  emailOpenedAt     DateTime? @map("email_opened_at")
  emailClickCount   Int       @default(0) @map("email_click_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  proposal        Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientScenarios ClientScenario[]

  @@map("client_portals")
}

model ClientScenario {
  id                         String   @id @default(uuid()) @db.Uuid
  proposalId                 String   @map("proposal_id") @db.Uuid
  portalId                   String   @map("portal_id") @db.Uuid
  aircraftValue              Decimal? @map("aircraft_value") @db.Decimal(14, 2)
  ownerHours                 Decimal? @map("owner_hours") @db.Decimal(10, 2)
  calculatedNetAnnualCost    Decimal? @map("calculated_net_annual_cost") @db.Decimal(14, 2)
  calculatedMonthlyCost      Decimal? @map("calculated_monthly_cost") @db.Decimal(14, 2)
  calculatedCostPerOwnerHour Decimal? @map("calculated_cost_per_owner_hour") @db.Decimal(14, 2)
  createdAt                  DateTime @default(now()) @map("created_at")

  proposal Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  portal   ClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@map("client_scenarios")
}

model ProposalTask {
  id          String    @id @default(uuid()) @db.Uuid
  proposalId  String    @map("proposal_id") @db.Uuid
  title       String
  status      String    @default("open")
  assignedTo  String?   @map("assigned_to") @db.Uuid
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_tasks")
}

// ——— PrismJet Crew (operational fleet + performance tables) ———

enum CrewFleetStatus {
  active
  retired
}

enum CrewPerformanceMetric {
  takeoffFieldLength
  landingDistance
}

/// Aircraft type catalog for Crew (e.g. B300 / King Air 350).
model CrewAircraftType {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  manufacturer String
  model        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  fleet        CrewFleetAircraft[]
  performance  CrewPerformanceGrid[]

  @@map("crew_aircraft_types")
}

/// Operational charter tail — independent of sales proposals.
model CrewFleetAircraft {
  id              String          @id @default(uuid()) @db.Uuid
  tailNumber      String          @unique @map("tail_number")
  aircraftTypeId  String          @map("aircraft_type_id") @db.Uuid
  status          CrewFleetStatus @default(active)
  homeBase        String?         @map("home_base")
  serialNumber    String?         @map("serial_number")
  operating       Json            @db.JsonB
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  aircraftType CrewAircraftType @relation(fields: [aircraftTypeId], references: [id], onDelete: Restrict)

  @@index([aircraftTypeId])
  @@map("crew_fleet_aircraft")
}

/// Type-level performance grid (pressure altitude × weight × OAT → length ft).
model CrewPerformanceGrid {
  id             String                @id @default(uuid()) @db.Uuid
  aircraftTypeId String                @map("aircraft_type_id") @db.Uuid
  metric         CrewPerformanceMetric
  unit           String                @default("ft")
  pressureAltitudeFt Int[]             @map("pressure_altitude_ft")
  weightLb       Int[]                 @map("weight_lb")
  oatC           Int[]                 @map("oat_c")
  values         Json                  @db.JsonB
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  aircraftType CrewAircraftType @relation(fields: [aircraftTypeId], references: [id], onDelete: Cascade)

  @@unique([aircraftTypeId, metric])
  @@map("crew_performance_grids")
}
