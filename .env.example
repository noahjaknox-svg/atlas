# Database — use Supabase *pooler* URL (port 6543) for the app; direct URL for migrations
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Portal session signing (min 32 chars)
PORTAL_SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Read-only API key for PrismJet Crew iOS app (Bearer token on GET /api/v1/crew/sync)
CREW_API_KEY="generate-a-long-random-read-only-key"

# Public production site — always used for invite emails, password resets, and client portal links
# (even when running npm run dev locally)
NEXT_PUBLIC_SITE_URL="https://www.prismjet.space"

# Optional local dev URL (only affects where you browse the app in development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# External data APIs (V1.1 — optional)
EIA_API_KEY=""
AVIATION_API_BASE_URL="https://api.aviationapi.com"
IFLIGHTPLANNER_API_KEY=""
ICAO_API_KEY=""

# Charter / JetInsight schedule
# JETINSIGHT_ICS_URL="https://portal.jetinsight.com/schedule/ics/..."
# SCHEDULE_SYNC_SECRET="cron-bearer-token-for-post-api-schedule-sync"
# CRON_SECRET is auto-sent by Vercel Cron as Authorization: Bearer <CRON_SECRET>
# to /api/cron/schedule-sync (hourly). Set auto-sync to Hourly or Daily in Charter Settings.
# POSTMARK_INBOUND_SECRET="webhook-secret-for-inbound-charter-emails"
# Import global airports: npm run db:ourairports-download && npm run db:ourairports-import

# Empty leg lead emails (Resend)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="PrismJet Charter <charter@yourdomain.com>"
