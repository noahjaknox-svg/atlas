{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && dotenv -e .env.local -o -- next dev -p 3005",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push --accept-data-loss",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-experience": "dotenv -e .env.local -- tsx scripts/seed-experience-templates.ts",
    "db:crew-seed": "dotenv -e .env.local -- tsx scripts/crew-seed.ts",
    "db:crew-import": "dotenv -e .env.local -- tsx scripts/import-crew-initial-data.ts",
    "db:crew-export-sample": "dotenv -e .env.local -- tsx scripts/export-crew-sync-sample.ts",
    "db:crew-export-airports-sample": "dotenv -e .env.local -- tsx scripts/export-crew-airports-sample.ts",
    "db:crew-export-airports-full": "dotenv -e .env.local -- tsx scripts/export-crew-airports-full.ts",
    "db:crew-export-airports-az-check": "dotenv -e .env.local -- tsx scripts/export-crew-airports-az-check.ts",
    "db:schedule-sync": "dotenv -e .env.local -- tsx scripts/sync-jetinsight-schedule.ts",
    "db:runway-slopes-seed": "dotenv -e .env.local -- tsx scripts/seed-runway-slopes.ts",
    "db:ourairports-download": "tsx scripts/download-ourairports.ts",
    "db:ourairports-import": "dotenv -e .env.local -- tsx scripts/import-ourairports.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.15.0",
    "geo-tz": "^8.1.7",
    "isomorphic-dompurify": "^3.18.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "14.2.21",
    "next-themes": "^0.4.6",
    "node-ical": "^0.26.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.0.2",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.21",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
